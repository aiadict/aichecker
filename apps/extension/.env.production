# Loaded automatically by `vite build` (mode "production"). Without this,
# VITE_APP_API_URL is undefined and apps/extension/src/lib/config.ts falls
# back to http://localhost:3000 — which is what every prior production
# build actually shipped with, including the Chrome Web Store / dev-mode
# loads users have been testing against werida.io.
VITE_APP_API_URL=https://werida.io
