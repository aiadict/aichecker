# ============================================================================
# AI Checker — environment variables
# Copy to .env (root, ignored by git) and to apps/web/.env.local as needed.
# NEVER commit real values. NEVER put the Pangram key in anything that ships
# to the browser extension bundle — server-side (apps/web) only.
# ============================================================================

# --- Pangram API -------------------------------------------------------------
# TODO(pangram-key): to be provided by the user later in development.
# Until this is set, apps/web/src/lib/pangram (packages/pangram-client) falls
# back to a deterministic MOCK response so the rest of the app is testable.
# Get it from: https://www.pangram.com (API tab, after account creation).
PANGRAM_API_KEY=
# Pricing reference (retail, confirm/replace once a key + contract exist):
#   realtime: $0.05 / 1,000 words   bulk: $0.04 / 1,000 words
# See docs/product-spec.md §3 for the margin math built around these numbers.

# --- Supabase ------------------------------------------------------------
# TODO: create a Supabase project (supabase.com) and fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
# TODO: create a Stripe account (test mode first) and fill these in.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Web app -----------------------------------------------------------------
# Production domain: werida.io (contact: hello@werida.io, support@werida.io).
# Keep localhost for local dev; set NEXT_PUBLIC_APP_URL=https://werida.io in
# the Vercel production environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (Supabase Auth provider) ------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
