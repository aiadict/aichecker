# ============================================================================
# AI Checker — environment variables
# Copy to .env (root, ignored by git) and to apps/web/.env.local as needed.
# NEVER commit real values. NEVER put the Pangram key in anything that ships
# to the browser extension bundle — server-side (apps/web) only.
# ============================================================================

# --- Pangram API -------------------------------------------------------------
# DONE — real key lives only in apps/web/.env.local (never committed). If
# unset, packages/pangram-client falls back to a deterministic MOCK response
# so the rest of the app stays testable without hitting the billed API.
# Live-verified: auth + request/response contract confirmed against the real
# API (see git history); full happy-path pending prepaid credits on the
# Pangram account (top up at pangram.com's Developer API tab).
PANGRAM_API_KEY=
# Pricing reference (retail, confirm/replace once contract terms are known):
#   realtime: $0.05 / 1,000 words   bulk: $0.04 / 1,000 words
# See docs/product-spec.md §3 for the margin math built around these numbers.

# --- Supabase ------------------------------------------------------------
# DONE — project "aichecker" is live (ref: najbzowkupdhlartoyjk, region:
# eu-west-1). Real values live only in apps/web/.env.local (never committed).
# Using the new publishable/secret key pair (not legacy anon/service_role —
# see docs/architecture.md). Migrations + seed already applied — see
# supabase/migrations/ and supabase/seed.sql, run via `supabase db push`
# against the project's Transaction pooler connection string (Dashboard →
# Connect → Transaction pooler; the direct-connection host is IPv6-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
# DONE (test mode) — account "werida sandbox" (acct_1TyZuTRouUhCdZVM).
# STRIPE_SECRET_KEY is a RESTRICTED key (rk_test_..., not a full sk_test_
# secret key) scoped to only: Checkout Sessions (write), Customers (write),
# Subscriptions (read), Customer Portal (write), Products/Prices (read).
# Real values live only in apps/web/.env.local (never committed).
# STRIPE_WEBHOOK_SECRET differs between local dev (`stripe listen --print-secret`)
# and production (a real webhook endpoint registered against werida.io, with
# its own signing secret) — do not reuse the local one in production.
# Products/prices were created via the Stripe CLI, one Product per plan (Pro,
# Business) per Stripe's own guidance — never multiple tiers on one Product.
# Managed Payments (Stripe/Link as merchant of record, on by default for new
# accounts) is explicitly disabled per Checkout Session — AI Checker is the
# merchant of record the customer sees, not Link. See docs/architecture.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# --- Web app -----------------------------------------------------------------
# Production domain: werida.io (contact: hello@werida.io, support@werida.io).
# Keep localhost for local dev; set NEXT_PUBLIC_APP_URL=https://werida.io in
# the Vercel production environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (Supabase Auth provider) ------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
